{
  "name": "notchy",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && vite dev",
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "pnpm run test:mutation:pure && pnpm run test:mutation:db",
    "test:mutation:pure": "stryker run",
    "test:mutation:db": "stryker run stryker.db.conf.mjs",
    "test:release-smoke": "node -e \"import('./package.json', { with: { type: 'json' } }).then(({ default: pkg }) => console.log('Desktop release checklist: specs/2026-07-27-desktop-release-smoke-checklist.md\\nPackage version: ' + pkg.version))\"",
    "test:release-tooling": "node --test scripts/release-dogfood.test.mjs",
    "test:roadmap": "node scripts/roadmap.mjs",
    "generate:db-contracts": "cargo run --manifest-path src-tauri/Cargo.toml --bin export_bindings",
    "check:db-contracts": "cargo run --manifest-path src-tauri/Cargo.toml --bin export_bindings -- --check",
    "check:native-db-cutover": "node scripts/check-native-db-cutover.mjs",
    "test:e2e": "playwright test",
    "release:dogfood": "node scripts/release-dogfood.mjs",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ],
    "patchedDependencies": {
      "@sveltejs/vite-plugin-svelte": "patches/@sveltejs__vite-plugin-svelte.patch"
    }
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@playwright/test": "1.52.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@sveltejs/adapter-static": "3.0.8",
    "@sveltejs/kit": "2.21.1",
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "@tauri-apps/cli": "2.5.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.2.8",
    "@types/better-sqlite3": "7.6.13",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.8",
    "@types/sql.js": "1.4.11",
    "@vitest/coverage-istanbul": "3.1.3",
    "autoprefixer": "10.4.21",
    "better-sqlite3": "11.9.1",
    "css-select": "7.0.0",
    "css-tree": "3.2.1",
    "domutils": "4.0.2",
    "htmlparser2": "12.0.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.3",
    "svelte": "5.28.2",
    "svelte-check": "4.2.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.1.3"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@inlang/paraglide-js": "1.11.8",
    "@inlang/paraglide-sveltekit": "0.15.3",
    "@tauri-apps/api": "2.5.0",
    "@tauri-apps/plugin-dialog": "2.2.0",
    "@tauri-apps/plugin-fs": "2.2.0",
    "@tauri-apps/plugin-opener": "2.5.0",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "layercake": "8.2.0",
    "sql.js": "1.14.1"
  }
}
